// Solicitud "Contáctenos" — venta asistida. No está ligada a un Club: es un
// lead que el superadmin revisa y luego convierte creando el club.
model ClubLead {
  id                String     @id @default(cuid())
  clubName          String
  deporte           String?
  city              String?
  department        String?
  contactName       String
  contactPhone      String
  contactEmail      String?
  memberCountApprox Int?
  message           String?
  status            LeadStatus @default(NEW)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum TipoPlan {
  MENSUAL
  TRIMESTRAL
  ANUAL
}

enum PostScope {
  PUBLIC
  PRIVATE
}
