generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Club ────────────────────────────────────────────────────────────────────

model Club {
  id                        String            @id @default(cuid())
  name                      String
  city                      String?
  department                String?
  logoUrl                   String?
  logoPublicId              String?
  coverUrl                  String? // portada del club
  coverPublicId             String? // public_id de Cloudinary
  verified                  Boolean           @default(false) // club verificado (sello) — espejo de verificationStatus == VERIFIED
  verificationStatus        ClubVerification  @default(PENDING) // estado de revisión del club auto-registrado
  nameFlagged               Boolean           @default(false) // el nombre chocó con uno existente → priorizar en la cola
  memberCountApprox         Int? // # aprox de miembros declarado al registrarse
  rejectionReason           String? // motivo si el superadmin lo rechaza
  reviewedAt                DateTime? // cuándo se verificó/rechazó
  active                    Boolean           @default(true)
  // true solo cuando NOSOTROS desactivamos el club por falta de pago — permite
  // reactivarlo automaticamente al pagar sin pisar una desactivacion manual
  // hecha por el superadmin por otro motivo (abuso, etc.)
  desactivadoPorVencimiento Boolean           @default(false)
  // Activacion manual del superadmin: mientras este en true, el chequeo de
  // vencimiento NO vuelve a desactivar el club (la decision manual manda).
  // Se limpia al registrar un pago real o al desactivar manualmente.
  activadoManualmente       Boolean           @default(false)
  trialEndsAt               DateTime?
  deporte                   String?
  // Fecha real de fundacion del club, la que el admin declara en Ajustes. No
  // confundir con createdAt, que es cuando se registraron en la plataforma.
  // Se guarda al mediodia UTC para que ningun huso corra el mes mostrado.
  foundedAt                 DateTime?
  description               String?
  phone                     String?
  email                     String?
  noAttendanceDays          Int[]
  // Inscripcion por enlace. El token es aleatorio y no derivado del nombre: con
  // una url adivinable, cualquiera encontraria el formulario de cualquier club
  // probando nombres. Si se filtra, se regenera y el enlace viejo muere.
  inscripcionToken          String?           @unique
  inscripcionAbierta        Boolean           @default(false)
  // Cuantos deportistas espera el club, para poder decirle cuantos faltan.
  inscripcionEsperados      Int?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  users                     User[]
  locations                 Location[]
  members                   Member[]
  payments                  Payment[]
  cashEntries               CashEntry[]
  competitions              Competition[]
  trainingSessions          TrainingSession[]
  calendarEvents            CalendarEvent[]
  attendances               Attendance[]
  suscripcion               ClubSuscripcion?
  posts                     Post[]
  cuponCanjes               CuponCanje[]
  clases                    ClaseHorario[]
}

// ─── User (staff: ADMIN, COACH, SUPERADMIN) ──────────────────────────────────

model User {
  id              String    @id @default(cuid())
  clerkId         String    @unique
  email           String    @unique
  name            String
  picture         String?
  coverUrl        String?
  coverPublicId   String?
  bio             String?
  role            Role      @default(ADMIN)
  profileComplete Boolean   @default(false)
  termsAcceptedAt DateTime?
  clubId          String?
  club            Club?     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clubId])
}

// ─── Location (sedes) ────────────────────────────────────────────────────────

model Location {
  id               String            @id @default(cuid())
  name             String
  address          String?
  latitude         Float?
  longitude        Float?
  clubId           String
  club             Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members          MemberLocation[]
  attendances      Attendance[]
  trainingSessions TrainingSession[]
  calendarEvents   CalendarEvent[]
  clases           ClaseHorario[]
  payments         Payment[]
  cashEntries      CashEntry[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clubId])
}

// ─── Member (deportistas) ────────────────────────────────────────────────────

model Member {
  id                String            @id @default(cuid())
  clubId            String
  club              Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fullName          String
  email             String?
  phone             String?
  birthDate         DateTime?
  pictureUrl        String?
  picturePublicId   String?
  docType           String?
  docNumber         String?
  docFileUrl        String?
  docFilePublicId   String?
  insuranceFileUrl  String?
  insurancePublicId String?
  // Acudiente. Para un deportista menor de edad son los datos de quien responde
  // por el; para un adulto, los de su contacto de emergencia. Es la misma pareja
  // de campos de siempre, lo que cambia es como se presenta, mas el parentesco y
  // la cedula, que solo se piden cuando es menor.
  emergencyContact  String?
  emergencyPhone    String?
  guardianRelation  String?
  guardianDocNumber String?
  eps               String?
  // Rama con la que compite. Las competencias de patinaje se dividen por sexo y
  // el dato no existia en ninguna parte: el club lo sabia de memoria, asi que
  // los resultados no se podian separar ni filtrar.
  gender            String?
  // Datos de emergencia. Es un deporte de caidas, con menores, y muchas veces
  // sin un adulto de la familia presente: si un nino se golpea, el entrenador
  // tenia la EPS y el telefono del acudiente, pero ni el tipo de sangre ni si
  // era alergico a algo.
  rh                String?
  allergies         String?
  category          String?
  tipo              String?
  paymentDueDay     Int?
  monthlyFee        Float?
  locations         MemberLocation[]
  attendances       Attendance[]
  payments          Payment[]
  eventResults      EventResult[]
  trainingResults   TrainingResult[]
  inviteStatus      InviteStatus      @default(PENDING)
  // Quien lo trajo. Solo se marca lo que entra por el formulario publico: es lo
  // unico que necesita revision y lo unico que se muestra como recien llegado.
  origen            OrigenMiembro     @default(MANUAL)
  // Los que llegan por el formulario nacen PENDIENTE y no entran a la app hasta
  // que el club los acepta. Todo lo demas nace aprobado, incluido lo que ya
  // existe: sin ese default, una migracion dejaria a todo el mundo afuera.
  inscripcion       EstadoInscripcion @default(APROBADO)
  aprobadoAt        DateTime?
  // Cambios que una familia mando por el enlace para un deportista que ya
  // estaba en el club. NO se aplican solos: viven aca hasta que el club los
  // revisa. Sin ese paso, saber una cedula y una fecha alcanzaria para
  // reescribir la ficha de otro.
  cambiosPendientes Json?
  clerkId           String?           @unique
  role              Role              @default(STUDENT)
  // Pausa temporal, no borrado. Los deportistas se van de vacaciones en
  // noviembre y vuelven en febrero: mientras esten inactivos no se les genera
  // cuota, no cuentan para el precio del plan del club y no entran a la app,
  // pero conservan asistencias, resultados y pagos anteriores.
  active            Boolean           @default(true)
  desactivadoAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([clubId])
  @@index([email])
  @@index([clubId, inviteStatus])
  @@index([clubId, active])
  // La bandeja de pendientes y el aviso de documento repetido se consultan a
  // cada rato y siempre acotados al club.
  @@index([clubId, inscripcion])
  @@index([clubId, docNumber])
}

model MemberLocation {
  memberId   String
  locationId String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([memberId, locationId])
}

// ─── Attendance (asistencia) ─────────────────────────────────────────────────

model Attendance {
  id         String           @id @default(cuid())
  clubId     String
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location?        @relation(fields: [locationId], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus
  notes      String?
  // Clase del horario a la que corresponde. Es opcional porque las asistencias
  // tomadas antes de que existiera el horario no pertenecen a ninguna, y
  // porque un club puede no armar horario nunca y seguir marcando por dia.
  claseId    String?
  clase      ClaseHorario?    @relation(fields: [claseId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())

  // La unicidad NO se declara aca. Antes era @@unique([memberId, date]), que es
  // justo lo que hacia que marcar en la segunda sede pisara la primera. Ahora
  // son dos indices unicos parciales creados a mano en la migracion:
  //
  //   UNIQUE (memberId, date) WHERE claseId IS NULL
  //   UNIQUE (memberId, date, claseId) WHERE claseId IS NOT NULL
  //
  // Hacen falta parciales porque Postgres considera que dos NULL son distintos:
  // un unico compuesto con claseId dejaria entrar duplicados justo en las filas
  // sin clase, que son todas las viejas. Prisma no sabe declarar indices
  // parciales, y por eso viven solo en el SQL.
  @@index([clubId, date])
  @@index([memberId])
  @@index([claseId, date])
}

// ─── Horario de clases ────────────────────────────────────────────────────────
//
// Lo que el club dicta cada semana: sede, dia, hora. La asistencia se toma
// sobre una de estas, y por eso un deportista puede estar en la clase de la
// mañana y en la de la tarde del mismo dia sin que una pise a la otra.
//
// Es opcional: un club que no arme su horario sigue marcando por dia como
// siempre, y ni se entera de que la funcion existe.

model ClaseHorario {
  id          String       @id @default(cuid())
  clubId      String
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  nombre      String
  // 0 = domingo … 6 = sabado. Mismo criterio que `Club.noAttendanceDays` y que
  // `Date.getDay()`, para no tener dos convenciones de dia dando vueltas.
  diaSemana   Int
  // "HH:mm" en 24h. Texto y no DateTime: es una hora de reloj que se repite
  // cada semana, no un instante, y guardarla como fecha arrastra husos.
  hora        String
  categoria   String?
  // Quitar una clase del horario no borra su historial de asistencia: se
  // desactiva y deja de aparecer de hoy en adelante.
  activa      Boolean      @default(true)
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clubId, diaSemana, activa])
}

// ─── Payment (pagos de mensualidad) ──────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount          Float
  month           Int
  year            Int
  dueDate         DateTime?
  paidAt          DateTime?
  status          PaymentStatus @default(PENDING)
  notes           String?
  receiptUrl      String?
  receiptPublicId String?
  // Sede a la que corresponde esta mensualidad. Se GUARDA, no se deduce del
  // miembro: deducirla haria que al cambiar alguien de sede se reescribiera
  // todo el historico solo y un reporte de marzo dejara de cuadrar.
  // Opcional porque lo registrado antes de esto no la tiene.
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  cashEntry       CashEntry?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clubId])
  @@index([memberId])
  @@index([clubId, year, month])
  @@index([clubId, status])
  @@index([clubId, locationId])
}

// ─── CashEntry (flujo de caja) ───────────────────────────────────────────────

model CashEntry {
  id          String        @id @default(cuid())
  clubId      String
  club        Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  type        CashEntryType
  amount      Float
  description String
  date        DateTime      @default(now())
  // Sede del movimiento. NULL = "General": lo que no es de ninguna disciplina
  // en particular (la suscripcion a VeloClub, la contabilidad, la publicidad),
  // y tambien todo lo registrado antes de que existiera este campo.
  locationId  String?
  location    Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  paymentId   String?       @unique
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([clubId])
  @@index([clubId, date])
  @@index([clubId, locationId])
}

// ─── Competition + Events + Results (logros) ─────────────────────────────────

model Competition {
  id        String             @id @default(cuid())
  clubId    String
  club      Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  place     String?
  latitude  Float?
  longitude Float?
  date      DateTime
  events    CompetitionEvent[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([clubId])
}

model CompetitionEvent {
  id            String        @id @default(cuid())
  competitionId String
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  results       EventResult[]
  createdAt     DateTime      @default(now())
}

model EventResult {
  id           String           @id @default(cuid())
  eventId      String
  event        CompetitionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position     Int?
  category     String?
  observations String?
  createdAt    DateTime         @default(now())

  @@unique([eventId, memberId])
  @@index([memberId])
}

// ─── TrainingSession + Results (entrenamientos) ──────────────────────────────

model TrainingSession {
  id         String           @id @default(cuid())
  clubId     String
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title      String
  date       DateTime
  // Donde se entrena decide que se mide: en pista se cronometra, en gimnasio se
  // levanta peso. El escenario vive en la sesion y no en cada resultado porque
  // un entrenamiento entero ocurre en un solo lugar.
  escenario  TrainingScenario @default(PISTA)
  locationId String?
  location   Location?        @relation(fields: [locationId], references: [id])
  notes      String?
  results    TrainingResult[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([clubId])
  @@index([clubId, date])
}

model TrainingResult {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Campos de pista
  time         String?
  distance     String?
  laps         Int?
  // Campos de gimnasio. La marca queda como texto libre porque no todo se mide
  // en kilos: hay salto vertical en centimetros y planchas en segundos.
  exercise     String?
  weight       String?
  sets         Int?
  reps         Int?
  mark         String?
  observations String?
  createdAt    DateTime        @default(now())

  @@unique([sessionId, memberId])
  @@index([memberId])
}

// ─── CalendarEvent (calendario) ──────────────────────────────────────────────

model CalendarEvent {
  id          String            @id @default(cuid())
  clubId      String
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  type        CalendarEventType
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean           @default(true)
  recurrence  RecurrenceType    @default(NONE)
  weekDays    Int[]
  locationId  String?
  location    Location?         @relation(fields: [locationId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clubId])
  @@index([clubId, startDate])
}

// ─── ClubSuscripcion (cobros de plataforma por club) ─────────────────────────

model ClubSuscripcion {
  id                         String            @id @default(cuid())
  clubId                     String            @unique
  club                       Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  planMonto                  Float             @default(450000)
  tipoPlan                   TipoPlan          @default(MENSUAL)
  año                       Int
  pagos                      SuscripcionPago[]
  // Mercado Pago — renovación automática
  autoRenew                  Boolean           @default(false)
  mpPreapprovalId            String?
  mpPayerEmail               String?
  ultimoMontoSincronizado    Float?
  // Tope de deportistas activos alcanzado en el ciclo de facturacion en curso.
  // Sin esto, un club podria desactivar a todos la vispera del cobro y
  // reactivarlos al dia siguiente para caer al tramo mas barato. El precio usa
  // el tope, asi que una baja real de deportistas se refleja en el ciclo
  // siguiente y no a mitad del que ya se esta cobrando.
  picoDeportistas            Int?
  intentosFallidos           Int               @default(0)
  ultimoIntentoFallidoAt     DateTime?
  // Cancelación explícita del admin: se apaga la renovación pero el club sigue
  // activo hasta que venza la vigencia. Se limpia al registrar un nuevo pago.
  canceladaAt                DateTime?
  // Consentimientos legales (Ley 1480 de 2011 — Estatuto del Consumidor)
  consentimientoPagoAt       DateTime?
  consentimientoRecurrenteAt DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([clubId])
}

model SuscripcionPago {
  id              String          @id @default(cuid())
  suscripcionId   String
  suscripcion     ClubSuscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  concepto        String
  monto           Float
  fecha           DateTime?
  estado          PaymentStatus   @default(PENDING)
  receiptUrl      String?
  receiptPublicId String?
  mpPaymentId     String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([suscripcionId])
}

// ─── Cupones de descuento (checkout de suscripción) ──────────────────────────

model Cupon {
  id           String       @id @default(cuid())
  codigo       String       @unique // guardado y comparado en MAYÚSCULAS
  porcentaje   Int // 1..100
  activo       Boolean      @default(true)
  expiraEn     DateTime? // null = sin expiración
  maxUsos      Int? // null = ilimitado (total de canjes permitidos)
  usosActuales Int          @default(0)
  canjes       CuponCanje[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CuponCanje {
  id              String   @id @default(cuid())
  cuponId         String
  cupon           Cupon    @relation(fields: [cuponId], references: [id], onDelete: Cascade)
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  montoDescontado Int // pesos descontados en el pago, para trazabilidad
  createdAt       DateTime @default(now())

  @@unique([cuponId, clubId]) // un club no puede usar el mismo cupón dos veces
  @@index([clubId])
}

// ─── Post (feed comunitario) ─────────────────────────────────────────────────

model Post {
  id            String        @id @default(cuid())
  clubId        String
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubName      String        @default("")
  authorClerkId String?
  authorName    String
  authorRole    String
  authorAvatar  String?
  content       String
  imageUrl      String?
  imagePublicId String?
  // Texto libre escrito por el autor. No es un lugar de mapas ni una sede del
  // club: solo la etiqueta que quiso ponerle a la publicacion.
  ubicacion     String?
  scope         PostScope     @default(PRIVATE)
  likes         PostLike[]
  comments      PostComment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clubId])
  @@index([scope, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id            String        @id @default(cuid())
  postId        String
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorClerkId String?
  authorName    String
  authorRole    String
  authorAvatar  String?
  content       String
  // Respuesta a otro comentario del mismo post. Un solo nivel: si alguien le
  // responde a una respuesta, el backend la cuelga del mismo padre en vez de
  // abrir otro escalon. Cuatro niveles anidados dejan el texto en una franja
  // de 90px en movil, ilegible.
  parentId      String?
  parent        PostComment?  @relation("RespuestasDeComentario", fields: [parentId], references: [id], onDelete: Cascade)
  respuestas    PostComment[] @relation("RespuestasDeComentario")
  createdAt     DateTime      @default(now())

  @@index([postId])
  @@index([postId, createdAt])
  @@index([parentId])
}

// ─── Reporte de contenido ─────────────────────────────────────────────────────
//
// Los Terminos dicen que VeloClub puede eliminar contenido que los incumpla
// "previa solicitud o de oficio". Esta tabla es la solicitud: sin ella la
// promesa no se podia cumplir, porque no habia forma de pedir nada.
//
// El contenido reportado NO se borra en cascada al resolverse: el reporte
// sobrevive a la publicacion para dejar constancia de que se atendio.

enum MotivoReporte {
  SPAM
  ACOSO // difamatorio, insultos, hostigamiento
  ODIO // discriminatorio
  CONTENIDO_SEXUAL
  VIOLENCIA
  SUPLANTACION
  DERECHOS_AUTOR
  OTRO
}

enum EstadoReporte {
  PENDIENTE
  ELIMINADO // se le dio la razon y el contenido se retiro
  DESESTIMADO // se reviso y no incumplia
}

model Reporte {
  id              String        @id @default(cuid())
  // Que se reporto. `postId` viaja siempre, tambien cuando el reporte es de un
  // comentario, para poder abrir la publicacion desde el panel.
  postId          String
  commentId       String?
  reporterClerkId String
  reporterName    String
  // Club del contenido reportado, para dar contexto al superadmin
  clubId          String?
  motivo          MotivoReporte
  detalle         String?
  estado          EstadoReporte @default(PENDIENTE)
  // Copia del texto al momento de reportar: si el autor lo edita o lo borra,
  // sin esto el superadmin revisaria un reporte sobre algo que ya no existe.
  contenidoCopia  String        @default("")
  autorClerkId    String?
  autorNombre     String        @default("")
  resueltoPor     String?
  resueltoEn      DateTime?
  createdAt       DateTime      @default(now())

  // Nadie reporta dos veces lo mismo: inflaba la cola sin aportar nada.
  @@unique([reporterClerkId, postId, commentId])
  @@index([estado, createdAt])
}

// ─── Auditoria ────────────────────────────────────────────────────────────────
//
// Bitacora de las acciones que no se pueden deshacer. Nace porque se borraron
// cinco clubes y no quedo forma de saber quien, cuando ni con que. El endpoint
// borraba, respondia ok y no escribia nada en ninguna parte.
//
// Tres decisiones que la hacen util y no decorativa:
//
// 1. `datos` guarda una copia de lo eliminado. Sin eso el registro dice que
//    algo se perdio pero no permite recuperarlo, que es justo lo que hizo
//    falta. Con la copia, rehacer un club borrado es leer un JSON.
// 2. Nunca tumba la operacion principal: si el registro falla, la accion sigue.
//    Un fallo al auditar no puede impedir que un admin trabaje.
// 3. No hay endpoint para editarla ni para borrarla. Un registro que se puede
//    alterar no sirve como registro.

model Auditoria {
  id           String   @id @default(cuid())
  // Que paso, en texto estable: CLUB_ELIMINADO, MIEMBRO_ELIMINADO, ROL_CAMBIADO…
  accion       String
  // Sobre que: 'Club', 'Member', 'Payment', 'CashEntry', 'Post'…
  entidad      String
  entidadId    String?
  // Frase legible, para leer la bitacora sin interpretar ids
  resumen      String
  // Quien lo hizo. Se copian nombre y correo del momento: si esa cuenta se
  // borra despues, el registro tiene que seguir diciendo quien fue.
  actorClerkId String?
  actorEmail   String?
  actorNombre  String?
  actorRol     String?
  // Club afectado, para poder filtrar por club
  clubId       String?
  clubNombre   String?
  // Copia de lo borrado o del antes/despues de un cambio
  datos        Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([accion, createdAt])
  @@index([clubId, createdAt])
}

// ─── Notificacion (SA global) ─────────────────────────────────────────────────

model Notificacion {
  id        String           @id @default(cuid())
  tipo      NotificacionTipo
  titulo    String
  cuerpo    String
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([leida, createdAt])
}

// Notificaciones dirigidas a usuarios del club (staff o deportistas).
// Una fila por destinatario. `tipo` es texto libre (PAYMENT_RECEIVED, PAYMENT_DUE,
// NEW_MEMBER, NEW_FOLLOWER, NEW_COMPETITION, NEW_EVENT, ...).
model Notification {
  id               String   @id @default(cuid())
  recipientClerkId String // a quién va dirigida
  clubId           String? // contexto (para el refresco en vivo por SSE)
  tipo             String
  titulo           String
  cuerpo           String
  link             String? // ruta interna a la que navega al hacer clic
  leida            Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([recipientClerkId, leida, createdAt])
}

// ─── Follow (sistema de seguidores) ─────────────────────────────────────────

model Follow {
  id               String   @id @default(cuid())
  followerClerkId  String
  followingClerkId String
  createdAt        DateTime @default(now())

  @@unique([followerClerkId, followingClerkId])
  @@index([followerClerkId])
  @@index([followingClerkId])
}

