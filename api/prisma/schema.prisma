generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Club ────────────────────────────────────────────────────────────────────

model Club {
  id                String          @id @default(cuid())
  name              String
  city              String?
  department        String?
  logoUrl           String?
  logoPublicId      String?
  coverUrl          String?         // portada del club
  coverPublicId     String?         // public_id de Cloudinary
  verified          Boolean         @default(false)  // club verificado (sello) — espejo de verificationStatus == VERIFIED
  verificationStatus ClubVerification @default(PENDING) // estado de revisión del club auto-registrado
  nameFlagged       Boolean         @default(false)  // el nombre chocó con uno existente → priorizar en la cola
  memberCountApprox Int?                             // # aprox de miembros declarado al registrarse
  rejectionReason   String?                          // motivo si el superadmin lo rechaza
  reviewedAt        DateTime?                        // cuándo se verificó/rechazó
  active            Boolean         @default(true)
  // true solo cuando NOSOTROS desactivamos el club por falta de pago — permite
  // reactivarlo automaticamente al pagar sin pisar una desactivacion manual
  // hecha por el superadmin por otro motivo (abuso, etc.)
  desactivadoPorVencimiento Boolean @default(false)
  // Activacion manual del superadmin: mientras este en true, el chequeo de
  // vencimiento NO vuelve a desactivar el club (la decision manual manda).
  // Se limpia al registrar un pago real o al desactivar manualmente.
  activadoManualmente Boolean @default(false)
  trialEndsAt       DateTime?
  deporte           String?
  // Fecha real de fundacion del club, la que el admin declara en Ajustes. No
  // confundir con createdAt, que es cuando se registraron en la plataforma.
  // Se guarda al mediodia UTC para que ningun huso corra el mes mostrado.
  foundedAt         DateTime?
  description       String?
  phone             String?
  email             String?
  noAttendanceDays  Int[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  users          User[]
  locations      Location[]
  members        Member[]
  payments       Payment[]
  cashEntries    CashEntry[]
  competitions      Competition[]
  trainingSessions  TrainingSession[]
  calendarEvents    CalendarEvent[]
  attendances    Attendance[]
  suscripcion    ClubSuscripcion?
  posts          Post[]
  cuponCanjes    CuponCanje[]
}

// ─── User (staff: ADMIN, COACH, SUPERADMIN) ──────────────────────────────────

model User {
  id              String   @id @default(cuid())
  clerkId         String   @unique
  email           String   @unique
  name            String
  picture         String?
  coverUrl        String?
  coverPublicId   String?
  bio             String?
  role            Role     @default(ADMIN)
  profileComplete Boolean  @default(false)
  termsAcceptedAt DateTime?
  clubId          String?
  club            Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clubId])
}

// ─── Location (sedes) ────────────────────────────────────────────────────────

model Location {
  id             String           @id @default(cuid())
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  clubId         String
  club           Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members          MemberLocation[]
  attendances      Attendance[]
  trainingSessions TrainingSession[]
  calendarEvents   CalendarEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([clubId])
}

// ─── Member (deportistas) ────────────────────────────────────────────────────

model Member {
  id                String           @id @default(cuid())
  clubId            String
  club              Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fullName          String
  email             String?
  phone             String?
  birthDate         DateTime?
  pictureUrl        String?
  picturePublicId   String?
  docType           String?
  docNumber         String?
  docFileUrl        String?
  docFilePublicId   String?
  insuranceFileUrl  String?
  insurancePublicId String?
  emergencyContact  String?
  emergencyPhone    String?
  eps               String?
  category          String?
  tipo              String?
  paymentDueDay     Int?
  monthlyFee        Float?
  locations         MemberLocation[]
  attendances       Attendance[]
  payments          Payment[]
  eventResults      EventResult[]
  trainingResults   TrainingResult[]
  inviteStatus      InviteStatus     @default(PENDING)
  clerkId           String?          @unique
  role              Role             @default(STUDENT)
  // Pausa temporal, no borrado. Los deportistas se van de vacaciones en
  // noviembre y vuelven en febrero: mientras esten inactivos no se les genera
  // cuota, no cuentan para el precio del plan del club y no entran a la app,
  // pero conservan asistencias, resultados y pagos anteriores.
  active            Boolean          @default(true)
  desactivadoAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([clubId])
  @@index([email])
  @@index([clubId, inviteStatus])
  @@index([clubId, active])
}

model MemberLocation {
  memberId   String
  locationId String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([memberId, locationId])
}

// ─── Attendance (asistencia) ─────────────────────────────────────────────────

model Attendance {
  id         String           @id @default(cuid())
  clubId     String
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location?        @relation(fields: [locationId], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus
  notes      String?
  createdAt  DateTime         @default(now())

  @@unique([memberId, date])
  @@index([clubId, date])
  @@index([memberId])
}

// ─── Payment (pagos de mensualidad) ──────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  clubId    String
  club      Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount    Float
  month     Int
  year      Int
  dueDate   DateTime?
  paidAt    DateTime?
  status    PaymentStatus @default(PENDING)
  notes           String?
  receiptUrl      String?
  receiptPublicId String?
  cashEntry       CashEntry?
  createdAt       DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clubId])
  @@index([memberId])
  @@index([clubId, year, month])
  @@index([clubId, status])
}

// ─── CashEntry (flujo de caja) ───────────────────────────────────────────────

model CashEntry {
  id          String        @id @default(cuid())
  clubId      String
  club        Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  type        CashEntryType
  amount      Float
  description String
  date        DateTime      @default(now())
  paymentId   String?       @unique
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([clubId])
  @@index([clubId, date])
}

// ─── Competition + Events + Results (logros) ─────────────────────────────────

model Competition {
  id        String             @id @default(cuid())
  clubId    String
  club      Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  place     String?
  latitude  Float?
  longitude Float?
  date      DateTime
  events    CompetitionEvent[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([clubId])
}

model CompetitionEvent {
  id            String        @id @default(cuid())
  competitionId String
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  results       EventResult[]
  createdAt     DateTime      @default(now())
}

model EventResult {
  id           String           @id @default(cuid())
  eventId      String
  event        CompetitionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position     Int?
  category     String?
  observations String?
  createdAt    DateTime         @default(now())

  @@unique([eventId, memberId])
  @@index([memberId])
}

// ─── TrainingSession + Results (entrenamientos) ──────────────────────────────

model TrainingSession {
  id         String           @id @default(cuid())
  clubId     String
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title      String
  date       DateTime
  // Donde se entrena decide que se mide: en pista se cronometra, en gimnasio se
  // levanta peso. El escenario vive en la sesion y no en cada resultado porque
  // un entrenamiento entero ocurre en un solo lugar.
  escenario  TrainingScenario @default(PISTA)
  locationId String?
  location   Location?        @relation(fields: [locationId], references: [id])
  notes      String?
  results    TrainingResult[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([clubId])
  @@index([clubId, date])
}

model TrainingResult {
  id          String          @id @default(cuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Campos de pista
  time        String?
  distance    String?
  laps        Int?
  // Campos de gimnasio. La marca queda como texto libre porque no todo se mide
  // en kilos: hay salto vertical en centimetros y planchas en segundos.
  exercise    String?
  weight      String?
  sets        Int?
  reps        Int?
  mark        String?
  observations String?
  createdAt   DateTime        @default(now())

  @@unique([sessionId, memberId])
  @@index([memberId])
}

// ─── CalendarEvent (calendario) ──────────────────────────────────────────────

model CalendarEvent {
  id          String            @id @default(cuid())
  clubId      String
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  type        CalendarEventType
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean           @default(true)
  recurrence  RecurrenceType    @default(NONE)
  weekDays    Int[]
  locationId  String?
  location    Location?         @relation(fields: [locationId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clubId])
  @@index([clubId, startDate])
}

// ─── ClubSuscripcion (cobros de plataforma por club) ─────────────────────────

model ClubSuscripcion {
  id                     String              @id @default(cuid())
  clubId                 String              @unique
  club                   Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  planMonto              Float               @default(450000)
  tipoPlan               TipoPlan            @default(MENSUAL)
  año                    Int
  pagos                  SuscripcionPago[]
  // Mercado Pago — renovación automática
  autoRenew              Boolean             @default(false)
  mpPreapprovalId        String?
  mpPayerEmail           String?
  ultimoMontoSincronizado Float?
  // Tope de deportistas activos alcanzado en el ciclo de facturacion en curso.
  // Sin esto, un club podria desactivar a todos la vispera del cobro y
  // reactivarlos al dia siguiente para caer al tramo mas barato. El precio usa
  // el tope, asi que una baja real de deportistas se refleja en el ciclo
  // siguiente y no a mitad del que ya se esta cobrando.
  picoDeportistas        Int?
  intentosFallidos       Int                 @default(0)
  ultimoIntentoFallidoAt DateTime?
  // Cancelación explícita del admin: se apaga la renovación pero el club sigue
  // activo hasta que venza la vigencia. Se limpia al registrar un nuevo pago.
  canceladaAt            DateTime?
  // Consentimientos legales (Ley 1480 de 2011 — Estatuto del Consumidor)
  consentimientoPagoAt       DateTime?
  consentimientoRecurrenteAt DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([clubId])
}

model SuscripcionPago {
  id              String          @id @default(cuid())
  suscripcionId   String
  suscripcion     ClubSuscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  concepto        String
  monto           Float
  fecha           DateTime?
  estado          PaymentStatus   @default(PENDING)
  receiptUrl      String?
  receiptPublicId String?
  mpPaymentId     String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([suscripcionId])
}

// ─── Cupones de descuento (checkout de suscripción) ──────────────────────────

model Cupon {
  id           String       @id @default(cuid())
  codigo       String       @unique   // guardado y comparado en MAYÚSCULAS
  porcentaje   Int                    // 1..100
  activo       Boolean      @default(true)
  expiraEn     DateTime?              // null = sin expiración
  maxUsos      Int?                   // null = ilimitado (total de canjes permitidos)
  usosActuales Int          @default(0)
  canjes       CuponCanje[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CuponCanje {
  id              String   @id @default(cuid())
  cuponId         String
  cupon           Cupon    @relation(fields: [cuponId], references: [id], onDelete: Cascade)
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  montoDescontado Int                 // pesos descontados en el pago, para trazabilidad
  createdAt       DateTime @default(now())

  @@unique([cuponId, clubId])         // un club no puede usar el mismo cupón dos veces
  @@index([clubId])
}

// ─── Post (feed comunitario) ─────────────────────────────────────────────────

model Post {
  id              String     @id @default(cuid())
  clubId          String
  club            Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubName        String     @default("")
  authorClerkId   String?
  authorName      String
  authorRole      String
  authorAvatar    String?
  content         String
  imageUrl        String?
  imagePublicId   String?
  // Texto libre escrito por el autor. No es un lugar de mapas ni una sede del
  // club: solo la etiqueta que quiso ponerle a la publicacion.
  ubicacion       String?
  scope           PostScope  @default(PRIVATE)
  likes           PostLike[]
  comments        PostComment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([clubId])
  @@index([scope, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorClerkId String?
  authorName  String
  authorRole  String
  authorAvatar String?
  content     String
  // Respuesta a otro comentario del mismo post. Un solo nivel: si alguien le
  // responde a una respuesta, el backend la cuelga del mismo padre en vez de
  // abrir otro escalon. Cuatro niveles anidados dejan el texto en una franja
  // de 90px en movil, ilegible.
  parentId    String?
  parent      PostComment?  @relation("RespuestasDeComentario", fields: [parentId], references: [id], onDelete: Cascade)
  respuestas  PostComment[] @relation("RespuestasDeComentario")
  createdAt   DateTime @default(now())

  @@index([postId])
  @@index([postId, createdAt])
  @@index([parentId])
}

// ─── Notificacion (SA global) ─────────────────────────────────────────────────

model Notificacion {
  id        String           @id @default(cuid())
  tipo      NotificacionTipo
  titulo    String
  cuerpo    String
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([leida, createdAt])
}

// Notificaciones dirigidas a usuarios del club (staff o deportistas).
// Una fila por destinatario. `tipo` es texto libre (PAYMENT_RECEIVED, PAYMENT_DUE,
// NEW_MEMBER, NEW_FOLLOWER, NEW_COMPETITION, NEW_EVENT, ...).
model Notification {
  id               String   @id @default(cuid())
  recipientClerkId String   // a quién va dirigida
  clubId           String?  // contexto (para el refresco en vivo por SSE)
  tipo             String
  titulo           String
  cuerpo           String
  link             String?  // ruta interna a la que navega al hacer clic
  leida            Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([recipientClerkId, leida, createdAt])
}

// ─── Follow (sistema de seguidores) ─────────────────────────────────────────

model Follow {
  id               String   @id @default(cuid())
  followerClerkId  String
  followingClerkId String
  createdAt        DateTime @default(now())

  @@unique([followerClerkId, followingClerkId])
  @@index([followerClerkId])
  @@index([followingClerkId])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  COACH
  STUDENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  MEDICAL_EXCUSE
  LATE
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
}

enum CashEntryType {
  INCOME
  EXPENSE
  REFUND
}

enum TrainingScenario {
  PISTA
  GIMNASIO
}

enum CalendarEventType {
  TRAINING
  MEETUP
  COMPETITION
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  CUSTOM
}

enum NotificacionTipo {
  CLUB_CREADO
  CLUB_DESACTIVADO
  PAGO_VENCIDO
  PAGO_REGISTRADO
}

enum ClubVerification {
  PENDING
  VERIFIED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISCARDED
}

// Solicitud "Contáctenos" — venta asistida. No está ligada a un Club: es un
// lead que el superadmin revisa y luego convierte creando el club.
model ClubLead {
  id                String     @id @default(cuid())
  clubName          String
  deporte           String?
  city              String?
  department        String?
  contactName       String
  contactPhone      String
  contactEmail      String?
  memberCountApprox Int?
  message           String?
  status            LeadStatus @default(NEW)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum TipoPlan {
  MENSUAL
  TRIMESTRAL
  ANUAL
}

enum PostScope {
  PUBLIC
  PRIVATE
}
